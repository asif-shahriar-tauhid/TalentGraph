NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentgraph_db?schema=public"

JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars_123456
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars_123456
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

SYSTEM_ADMIN_NAME="System Admin"
SYSTEM_ADMIN_EMAIL="admin@talentgraph.com"
SYSTEM_ADMIN_PASSWORD="AdminPassword@123"

REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_SENDER="TalentGraph <no-reply@talentgraph.com>"

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
