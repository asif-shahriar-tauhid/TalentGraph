model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role
  githubId         String?           @unique
  githubToken      String?
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}
